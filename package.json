  "type": "commonjs",
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@stylexjs/rollup-plugin": "^0.19.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-stylex": "^0.13.0",
    "wait-on": "^9.1.0"
